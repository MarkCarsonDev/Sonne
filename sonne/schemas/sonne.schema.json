{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sonne.dev/schemas/sonne.schema.json",
  "title": "Sonne Configuration",
  "description": "Configuration schema for Sonne static site generator",
  "type": "object",
  "properties": {
    "site": {
      "type": "object",
      "description": "Site-wide configuration",
      "properties": {
        "title": {
          "type": "string",
          "description": "Site title",
          "minLength": 1
        },
        "base_url": {
          "type": "string",
          "description": "Base URL for the site (e.g., https://example.com)",
          "format": "uri"
        },
        "description": {
          "type": "string",
          "description": "Site description for meta tags"
        },
        "author": {
          "type": "string",
          "description": "Site author name"
        },
        "keywords": {
          "type": "array",
          "description": "SEO keywords",
          "items": {
            "type": "string"
          }
        },
        "language": {
          "type": "string",
          "description": "Site language code (e.g., en, de, fr)",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
          "default": "en"
        },
        "nav": {
          "type": "array",
          "description": "Site navigation entries (rendered by the bundled templates)",
          "items": {
            "type": "object",
            "properties": {
              "text": { "type": "string", "description": "Link text" },
              "url": { "type": "string", "description": "Link target" }
            },
            "required": ["text", "url"]
          }
        },
        "footer": {
          "type": "object",
          "description": "Footer content (used by some templates)",
          "properties": {
            "text": { "type": "string", "description": "Footer text" },
            "links": {
              "type": "array",
              "description": "Footer links",
              "items": {
                "type": "object",
                "properties": {
                  "text": { "type": "string" },
                  "url": { "type": "string" }
                }
              }
            }
          },
          "additionalProperties": true
        },
        "weather": {
          "type": "object",
          "description": "Weather/location settings consumed by the solar template's data scripts",
          "additionalProperties": true
        }
      },
      "required": ["title", "base_url"]
    },
    "paths": {
      "type": "object",
      "description": "Directory paths",
      "properties": {
        "content": {
          "type": "string",
          "description": "Content directory",
          "default": "content"
        },
        "output": {
          "type": "string",
          "description": "Build output directory",
          "default": "output"
        },
        "static": {
          "type": "string",
          "description": "Static assets directory",
          "default": "static"
        },
        "templates": {
          "type": "string",
          "description": "Templates directory",
          "default": "templates"
        },
        "data": {
          "type": "string",
          "description": "Data files directory",
          "default": "data"
        },
        "cache": {
          "type": "string",
          "description": "Cache directory",
          "default": ".cache"
        },
        "scripts": {
          "type": "string",
          "description": "Data scripts directory",
          "default": "scripts"
        }
      },
      "required": ["content", "output", "templates"]
    },
    "blog": {
      "type": "object",
      "description": "Blog configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable blog functionality",
          "default": true
        },
        "directory": {
          "type": "string",
          "description": "Blog posts directory (relative to content)",
          "default": "blog"
        },
        "template": {
          "type": "string",
          "description": "Template for individual blog posts",
          "default": "blog_post.html"
        },
        "list_template": {
          "type": "string",
          "description": "Template for blog post listing",
          "default": "blog_list.html"
        },
        "posts_per_page": {
          "type": "integer",
          "description": "Number of posts per page in listings",
          "minimum": 1,
          "default": 10
        },
        "excerpt_length": {
          "type": "integer",
          "description": "Length of auto-generated excerpts in characters",
          "minimum": 0,
          "default": 200
        },
        "url_pattern": {
          "type": "string",
          "description": "URL pattern for blog posts (use {year}, {month}, {day}, {slug})",
          "default": "{year}/{month}/{day}/{slug}"
        },
        "include_drafts": {
          "type": "boolean",
          "description": "Include draft posts in build",
          "default": false
        },
        "taxonomies": {
          "type": "object",
          "description": "Taxonomy configuration (tags, categories)",
          "properties": {
            "tags": {
              "$ref": "#/definitions/taxonomy"
            },
            "categories": {
              "$ref": "#/definitions/taxonomy"
            }
          }
        },
        "rss": {
          "type": "object",
          "description": "RSS feed configuration",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Generate an RSS feed",
              "default": true
            },
            "path": {
              "type": "string",
              "description": "Feed path relative to the output directory",
              "default": "feed.xml"
            },
            "max_items": {
              "type": "integer",
              "description": "Maximum number of items in the feed",
              "minimum": 1,
              "default": 20
            }
          }
        },
        "date_archives": {
          "type": "boolean",
          "description": "Generate /blog/YYYY/ and /blog/YYYY/MM/ archive pages",
          "default": true
        },
        "archive_template": {
          "type": "string",
          "description": "Template for date archive pages",
          "default": "archive.html"
        }
      }
    },
    "images": {
      "type": "object",
      "description": "Image processing configuration",
      "properties": {
        "dither": {
          "type": "boolean",
          "description": "Enable dithering effect on images",
          "default": true
        },
        "optimize": {
          "type": "boolean",
          "description": "Optimize images for web",
          "default": true
        },
        "formats": {
          "type": "array",
          "description": "Output image formats",
          "items": {
            "type": "string",
            "enum": ["webp", "png", "jpg", "jpeg"]
          },
          "default": ["webp", "png"]
        },
        "sizes": {
          "type": "array",
          "description": "Image widths to generate",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "default": [1200, 800, 400]
        },
        "lazy_loading": {
          "type": "boolean",
          "description": "DEPRECATED (no effect): loading=\"lazy\" is always set on generated <img> tags",
          "default": true
        },
        "grayscale_before_dither": {
          "type": "boolean",
          "description": "DEPRECATED (no effect): grayscale conversion is part of the chosen dither_method",
          "default": false
        },
        "only_used": {
          "type": "boolean",
          "description": "Only process images actually referenced from content or templates",
          "default": false
        },
        "dither_method": {
          "type": "string",
          "description": "Dithering algorithm",
          "enum": ["bayer", "grayscale", "palette", "1bit", "halftone", "floyd_steinberg", "threshold", "color_median", "color_octree", "color_lab"],
          "default": "bayer"
        },
        "dither_colors": {
          "type": "integer",
          "description": "Number of colors/levels for dithering (2-256)",
          "minimum": 2,
          "maximum": 256,
          "default": 4
        },
        "dither_formats": {
          "type": "array",
          "description": "Formats to save dithered variants in",
          "items": { "type": "string", "enum": ["webp", "png", "jpg", "jpeg"] },
          "default": ["webp"]
        },
        "dither_sizes": {
          "type": "array",
          "description": "Widths to generate dithered variants at (default: smallest of images.sizes)",
          "items": { "type": "integer", "minimum": 1 }
        },
        "dither_cover_images": {
          "type": "boolean",
          "description": "Dither blog cover images",
          "default": true
        },
        "blog_original_max_width": {
          "type": "integer",
          "description": "Maximum width for blog post 'original' images",
          "minimum": 1,
          "default": 1600
        },
        "blog_dithered_max_width": {
          "type": "integer",
          "description": "Maximum width for blog post dithered images",
          "minimum": 1,
          "default": 400
        },
        "webp_method": {
          "type": "integer",
          "description": "WebP encoder effort for dithered saves (0=fast .. 6=small)",
          "minimum": 0,
          "maximum": 6,
          "default": 0
        },
        "webp_method_original": {
          "type": "integer",
          "description": "WebP encoder effort for original saves (0=fast .. 6=small)",
          "minimum": 0,
          "maximum": 6,
          "default": 4
        },
        "parallel": {
          "type": "boolean",
          "description": "Process images in parallel",
          "default": true
        },
        "parallel_workers": {
          "type": "integer",
          "description": "Worker threads for parallel processing (0 = auto)",
          "minimum": 0,
          "default": 0
        },
        "parallel_processing": {
          "type": "boolean",
          "description": "DEPRECATED: use images.parallel (aliased automatically with a warning)",
          "default": true
        },
        "max_workers": {
          "type": "integer",
          "description": "DEPRECATED: use images.parallel_workers (aliased automatically with a warning)",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "variables": {
      "type": "object",
      "description": "Variable management configuration",
      "properties": {
        "file": {
          "type": "string",
          "description": "Variable storage file",
          "default": "sonne_variables.json"
        },
        "preserve_prior": {
          "type": "boolean",
          "description": "Persist script-produced variables across builds via the variable file. When false (default) every build starts fresh and no variable file is written. Derived state (posts, taxonomies) never persists.",
          "default": false
        }
      }
    },
    "serve": {
      "type": "object",
      "description": "Development server settings",
      "properties": {
        "host": {
          "type": "string",
          "description": "Host to bind the dev server to",
          "default": "localhost"
        },
        "port": {
          "type": "integer",
          "description": "Port for the dev server",
          "minimum": 0,
          "maximum": 65535,
          "default": 8000
        }
      }
    },
    "solar": {
      "type": "object",
      "description": "Settings for the solar template's data scripts (theme-specific; not read by Sonne core)",
      "additionalProperties": true
    },
    "security": {
      "type": "object",
      "description": "Security settings",
      "properties": {
        "allow_embedded_python": {
          "type": "boolean",
          "description": "⚠️ WARNING: Allows arbitrary code execution in content files. Only enable if you trust ALL content authors.",
          "default": false
        },
        "csp": {
          "type": "object",
          "description": "Content Security Policy configuration",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable CSP header generation",
              "default": false
            },
            "directives": {
              "type": "object",
              "description": "CSP directives",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "url_style": {
      "description": "URL style for generated pages",
      "oneOf": [
        {
          "type": "string",
          "enum": ["clean", "html", "directory"],
          "description": "Single URL style for all environments"
        },
        {
          "type": "object",
          "description": "Different URL styles per environment",
          "properties": {
            "prod": {
              "type": "string",
              "enum": ["clean", "html", "directory"],
              "default": "clean"
            },
            "dev": {
              "type": "string",
              "enum": ["clean", "html", "directory"],
              "default": "directory"
            }
          }
        }
      ]
    },
    "environment": {
      "type": "string",
      "description": "Current environment",
      "enum": ["prod", "dev"],
      "default": "prod"
    },
    "build": {
      "type": "object",
      "description": "Build configuration",
      "properties": {
        "incremental": {
          "type": "boolean",
          "description": "Enable incremental builds (only process changed files)",
          "default": true
        },
        "show_progress": {
          "type": "boolean",
          "description": "Show progress bars during build",
          "default": true
        },
        "statistics": {
          "type": "boolean",
          "description": "Show build statistics on completion",
          "default": true
        },
        "show_page_size": {
          "type": "boolean",
          "description": "Inject a page-size label (with image-weight tooltip) into generated pages",
          "default": false
        }
      }
    }
  },
  "required": ["site"],
  "definitions": {
    "taxonomy": {
      "type": "object",
      "description": "Configuration for a taxonomy type",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable this taxonomy",
          "default": true
        },
        "template": {
          "type": "string",
          "description": "Template for individual taxonomy page"
        },
        "list_template": {
          "type": "string",
          "description": "Template for taxonomy listing"
        }
      }
    }
  }
}
